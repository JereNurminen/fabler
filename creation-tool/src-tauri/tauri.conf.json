{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "productName": "fabler",
  "version": "0.0.1",
  "app": {
    "windows": [
      {
        "title": "fabler",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      },
      "capabilities": [
        {
          "identifier": "core",
          "permissions": [
            "core:default",
            "dialog:default",
            "fs:allow-write-text-file",
            "fs:allow-write-file",
            "fs:allow-read-text-file",
            "fs:allow-read-file"
          ],
          "windows": ["main"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.fabler.app"
}
